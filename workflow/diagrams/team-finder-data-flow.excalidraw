      "link": null,
      "locked": false,
      "text": "Project flow\n/dashboard and /projects read projects\n/create inserts projects\n/[id] reads project + project_members\n/[id]/edit updates projects\nmatching code computes client-side score from skills/rating/availability",
      "fontSize": 16,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Project flow\n/dashboard and /projects read projects\n/create inserts projects\n/[id] reads project + project_members\n/[id]/edit updates projects\nmatching code computes client-side score from skills/rating/availability",
      "autoResize": false
