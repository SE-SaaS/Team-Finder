      "updated": 1779990000000,
      "link": null,
      "locked": false,
      "text": "Profile wizard flow\nProfileWizardController hydrates profiles, user_skills, user_courses\nloads eligible courses by university/major/year\nPOST /api/profile/complete\nupsert profile\nreplace skills/courses\ncourse prerequisites unlock skills",
      "fontSize": 16,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Profile wizard flow\nProfileWizardController hydrates profiles, user_skills, user_courses\nloads eligible courses by university/major/year\nPOST /api/profile/complete\nupsert profile\nreplace skills/courses\ncourse prerequisites unlock skills",
      "autoResize": false
    },
