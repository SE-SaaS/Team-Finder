      "link": null,
      "locked": false,
      "text": "Matching and scoring\nfrontend/src/algorithm/finalScore.ts\nproject skills + student skills -> binary vectors\ncosineSimilarity for skill component\nrating normalized /5\navailScore for availability\nweights combine base score\nlow-rating penalty multiplier\nrounded 0-100 result with breakdown",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Matching and scoring\nfrontend/src/algorithm/finalScore.ts\nproject skills + student skills -> binary vectors\ncosineSimilarity for skill component\nrating normalized /5\navailScore for availability\nweights combine base score\nlow-rating penalty multiplier\nrounded 0-100 result with breakdown",
      "autoResize": false
    },
