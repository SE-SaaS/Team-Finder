      "versionNonce": 200027,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1779990000000,
      "link": null,
      "locked": false,
      "text": "Backend internals\nStartup requires NEXT_PUBLIC_SUPABASE_URL, DATABASE_URL, ANTHROPIC_API_KEY\nJWT verifier loads Supabase JWKS and enforces JU/HU email domain\nThread ID format: user_id:uuid\nAgent tools use psycopg2 connection pool for allowed SQL access\nCheckpointer uses async psycopg pool",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Backend internals\nStartup requires NEXT_PUBLIC_SUPABASE_URL, DATABASE_URL, ANTHROPIC_API_KEY\nJWT verifier loads Supabase JWKS and enforces JU/HU email domain\nThread ID format: user_id:uuid\nAgent tools use psycopg2 connection pool for allowed SQL access\nCheckpointer uses async psycopg pool",
      "autoResize": false
    },
